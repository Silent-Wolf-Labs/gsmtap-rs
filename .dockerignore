# Repository metadata and development-only files
.git
.github
.gitignore
.dockerignore
.idea
.vscode
.DS_Store
*.swp
reference
scripts
docs
*.md

# Rust build output and generated release material
target
dist
build
*.cdx.json
SHA256SUMS.txt
release-artifacts

# Node development dependencies, test configuration, and generated output
node_modules
coverage
.npm
package.json
package-lock.json
jest.config.mjs
static/components/package.json

# Local configuration and secrets
.env
.env.*
!.env.example

# Python caches, virtual environments, and test-tool state
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Keep only the test inputs required by the traffic-test image.
tests/*
!tests/
!tests/vectors/
!tests/vectors/*.json
!tests/traffic/
!tests/traffic/*.py
!tests/traffic/*.toml
